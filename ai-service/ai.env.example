# Copy to ai.env (NOT committed) and fill in. Used by scripts/start-ai.ps1.
# Same value as AI_SERVICE_SECRET in Vercel (>= 24 characters).
AILOKAL_SERVICE_SECRET=
# Supabase project URL and SECRET key (Project Settings -> API Keys -> Secret key).
# Lets the 3D worker save progress and the GLB. Never put this key in the frontend.
AILOKAL_SUPABASE_URL=
AILOKAL_SUPABASE_SERVICE_KEY=
# No NVIDIA GPU? Allow slow CPU generation (minutes per model).
AILOKAL_ALLOW_CPU_RECONSTRUCTION=true
AILOKAL_PRELOAD_MODELS=true
