# ---------------------------------------------------------------- frontend (Next.js)
# Public (inlined into the browser bundle at build time)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=           # `supabase status` -> anon key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only secrets (never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=               # `supabase status` -> service_role key
AI_SERVICE_URL=http://localhost:8000     # internal network only
AI_SERVICE_SECRET=                       # >= 24 chars, same value as AILOKAL_SERVICE_SECRET

RETENTION_DAYS=30                        # uploads auto-delete after N days
RATE_LIMIT_URL_PER_HOUR=30
RATE_LIMIT_UPLOAD_PER_HOUR=30
RATE_LIMIT_VALIDATE_PER_DAY=60
RATE_LIMIT_LOGIN_PER_15MIN=10
RATE_LIMIT_REGISTER_PER_HOUR=5
GENERATION_DAILY_LIMIT=5                # 3D generations per user per 24 h
GENERATION_QUEUE_CAP=10                 # max queued+running jobs overall (protects the GPU)
AI_SERVICE_HOURS="Senin–Jumat, 08.00–22.00 WIB"   # optional: shown when the AI service is off
MARKETPLACE_USER_AGENT="AR-LOKAL-Preview/0.1 (+product preview; respects robots.txt)"

# ---------------------------------------------------------------- ai-service (FastAPI)
AILOKAL_SERVICE_SECRET=                  # shared secret with the Next.js server
AILOKAL_MODELS_DIR=models
AILOKAL_PRELOAD_MODELS=true
# 3D worker writes job progress + GLB to Supabase with a server-only credential
AILOKAL_SUPABASE_URL=http://localhost:54321
AILOKAL_SUPABASE_SERVICE_KEY=            # service_role / sb_secret key - never in the frontend bundle
AILOKAL_ALLOW_CPU_RECONSTRUCTION=false   # true = allow slow CPU inference when no CUDA GPU
# Validation config overrides: AILOKAL_VALIDATION__<SECTION>__<KEY>=value
# e.g. AILOKAL_VALIDATION__QUALITY__SHARPNESS_REJECT=40
# DEV ONLY - run without detectors you could not download (weaker validation!):
# AILOKAL_VALIDATION__REQUIRED_DETECTORS=[segmentation, objects]

# ---------------------------------------------------------------- tests
# E2E against a running stack
E2E_BASE_URL=http://localhost:3000
E2E_MAILPIT_URL=http://127.0.0.1:54324   # supabase start: Mailpit/Inbucket UI port
E2E_AI_MODE=partial                      # partial | unavailable
# DB tests against a real `supabase start` DB instead of embedded Postgres
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
